# --- Base de datos (Supabase / PostgreSQL, usada por Prisma ORM) ---
POSTGRES_PRISMA_URL="postgresql://postgres.[PROJECT-ID]:[PASSWORD]@[HOST-POOLER]:6543/postgres?pgbouncer=true"
# Si falla por IPv6, usar la del Session pooler (puerto 5432).
POSTGRES_URL_NON_POOLING="postgresql://postgres.[PROJECT-ID]:[PASSWORD]@[HOST-POOLER]:5432/postgres"

# --- Claves de acceso a Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-secret-key"

# Integración con Google Gemini AI (Base de Conocimiento / Reglamento)
GEMINI_API_KEY="your-gemini-api-key"


# Clave secreta para tokens de autenticación JWT
JWT_SECRET="your-jwt-secret-key"
